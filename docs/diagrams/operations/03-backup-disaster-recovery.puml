@startuml

title Enterprise AI Orchestration Platform
title Backup & Disaster Recovery Architecture

!theme plain

left to right direction

skinparam backgroundColor white
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle

skinparam defaultFontName Segoe UI
skinparam defaultFontSize 14

skinparam RectangleBorderColor #404040
skinparam RectangleBorderThickness 1.5
skinparam RectangleRoundCorner 10

skinparam PackageBorderColor #404040
skinparam PackageBorderThickness 2

skinparam ArrowThickness 1.5
skinparam ArrowColor #404040

package "Production Environment" {

    rectangle "Cloud Run Services" as CloudRun

    database "Firestore" as Firestore

    database "Google Cloud Storage" as GCS

    database "Qdrant Vector DB" as Qdrant

}

package "Backup Services" {

    rectangle "Scheduled Backup Jobs" as BackupJobs

    database "Cloud Storage Backup Bucket" as BackupBucket

}

package "Recovery Environment" {

    rectangle "Disaster Recovery Deployment" as DR

    database "Recovered Firestore" as DRFirestore

    database "Recovered Qdrant" as DRQdrant

    database "Recovered Storage" as DRStorage

}

package "Operations" {

    rectangle "Cloud Monitoring" as Monitoring

    rectangle "Alerting Policies" as Alerts

}

CloudRun --> Firestore

CloudRun --> GCS

CloudRun --> Qdrant

Firestore --> BackupJobs

GCS --> BackupJobs

Qdrant --> BackupJobs

BackupJobs --> BackupBucket

BackupBucket --> DRFirestore

BackupBucket --> DRQdrant

BackupBucket --> DRStorage

DR --> DRFirestore

DR --> DRQdrant

DR --> DRStorage

Monitoring --> Alerts

Alerts --> DR

@enduml