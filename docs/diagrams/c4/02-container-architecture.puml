@startuml

'==============================================================================
' Enterprise AI Orchestration Platform
' C4 Model - Level 2 - Container Architecture
'==============================================================================

!theme plain

title Enterprise AI Orchestration Platform
title C4 Model - Level 2 - Container Architecture

left to right direction

skinparam backgroundColor white
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle

skinparam defaultFontName Segoe UI
skinparam defaultFontSize 14

skinparam RectangleBorderColor #404040
skinparam RectangleBorderThickness 1.5
skinparam RectangleRoundCorner 10

skinparam PackageBorderColor #404040
skinparam PackageBorderThickness 2

skinparam ArrowThickness 1.5
skinparam ArrowColor #404040

'==============================================================================
' USERS
'==============================================================================

package "Users" {

actor "Business User" as BusinessUser
actor "Platform Administrator" as PlatformAdmin
actor "AI Administrator" as AIAdmin

}

'==============================================================================
' PRESENTATION LAYER
'==============================================================================

package "Presentation Layer" {

rectangle "React Web Portal\n(TypeScript + Material UI)" as React

}

'==============================================================================
' APPLICATION LAYER
'==============================================================================

package "Application Layer" {

rectangle "FastAPI Backend\n(API Gateway)" as API

rectangle "Authentication Service" as Auth

rectangle "Workflow Service" as Workflow

rectangle "Document Service" as Document

}

'==============================================================================
' AI ORCHESTRATION
'==============================================================================

package "AI Orchestration Layer" {

rectangle "LangGraph Runtime" as LangGraph

rectangle "MCP Client" as MCP

}

'==============================================================================
' AI SERVICES
'==============================================================================

package "Vertex AI Services" {

rectangle "Gemini LLM" as Gemini

rectangle "Embedding Models" as Embeddings

rectangle "Safety & Grounding" as Safety

}

'==============================================================================
' KNOWLEDGE PLATFORM
'==============================================================================

package "Knowledge Platform" {

database "Qdrant\nVector Database" as Qdrant

database "Firestore\nMetadata Registry" as Firestore

database "Google Cloud Storage\n(Document Repository)" as GCS

}

'==============================================================================
' PLATFORM SERVICES
'==============================================================================

package "Platform Services" {

rectangle "Cloud IAM" as IAM

rectangle "Secret Manager" as Secrets

rectangle "Cloud Logging" as Logging

rectangle "Cloud Monitoring" as Monitoring

}

'==============================================================================
' EXTERNAL SYSTEMS
'==============================================================================

package "Enterprise Integrations" {

rectangle "Enterprise\nContent Sources" as Content

rectangle "Enterprise\nApplications" as Enterprise

rectangle "External MCP\nServers" as MCPServers

}

'==============================================================================
' USER INTERACTION
'==============================================================================

BusinessUser --> React : Uses

PlatformAdmin --> React : Administers

AIAdmin --> React : Configures

React --> API : REST / HTTPS

'==============================================================================
' APPLICATION FLOW
'==============================================================================

API --> Auth

API --> Workflow

API --> Document

Workflow --> LangGraph

Workflow --> MCP

Workflow --> Gemini

Workflow --> Embeddings

Workflow --> Safety

Workflow --> Qdrant

Workflow --> Firestore

Document --> GCS

Document --> Firestore

Document --> Qdrant

'==============================================================================
' PLATFORM SERVICES
'==============================================================================

API --> IAM

API --> Secrets

API --> Logging

API --> Monitoring

'==============================================================================
' EXTERNAL INTEGRATIONS
'==============================================================================

Content --> GCS : Document Ingestion

Enterprise --> API : Business APIs

MCP --> MCPServers : Tool Invocation

@enduml