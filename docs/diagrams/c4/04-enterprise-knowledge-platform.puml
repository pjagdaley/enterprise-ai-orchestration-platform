@startuml

'==============================================================================
' Enterprise AI Orchestration Platform
' Enterprise Knowledge Platform
'==============================================================================

!theme plain

title Enterprise AI Orchestration Platform
title Enterprise Knowledge Platform

left to right direction

skinparam backgroundColor white
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle

skinparam defaultFontName Segoe UI
skinparam defaultFontSize 14

skinparam RectangleBorderColor #404040
skinparam RectangleBorderThickness 1.5
skinparam RectangleRoundCorner 10

skinparam PackageBorderColor #404040
skinparam PackageBorderThickness 2

skinparam ArrowThickness 1.5
skinparam ArrowColor #404040

'==============================================================================
' ENTERPRISE CONTENT SOURCES
'==============================================================================

package "Enterprise Content Sources" {

rectangle "Google Drive" as Drive

rectangle "SharePoint" as SharePoint

rectangle "GitHub" as GitHub

rectangle "Local Uploads" as Uploads

rectangle "Enterprise Applications" as Enterprise

}

'==============================================================================
' INGESTION SERVICES
'==============================================================================

package "Knowledge Ingestion" {

rectangle "Document Service" as Document

rectangle "Ingestion Service" as Ingestion

rectangle "Parser Service" as Parser

rectangle "Chunking Service" as Chunker

rectangle "Embedding Service" as Embedding

}

'==============================================================================
' VERTEX AI
'==============================================================================

package "Vertex AI" {

rectangle "Embedding Models" as Models

}

'==============================================================================
' KNOWLEDGE PLATFORM
'==============================================================================

package "Knowledge Platform" {

database "Google Cloud Storage\n(Document Repository)" as GCS

database "Firestore\nMetadata Registry" as Firestore

database "Qdrant\nVector Database" as Qdrant

}

'==============================================================================
' QUERY SERVICES
'==============================================================================

package "Knowledge Retrieval" {

rectangle "Search Service" as Search

rectangle "Hybrid Retriever" as Hybrid

rectangle "CrossEncoder\nReranker" as Reranker

rectangle "Citation Service" as Citation

}

'==============================================================================
' INGESTION FLOW
'==============================================================================

Drive --> Document

SharePoint --> Document

GitHub --> Document

Uploads --> Document

Enterprise --> Document

Document --> GCS

Document --> Firestore

Document --> Ingestion

Ingestion --> Parser

Parser --> Chunker

Chunker --> Embedding

Embedding --> Models

Embedding --> Qdrant

Embedding --> Firestore

'==============================================================================
' QUERY FLOW
'==============================================================================

Search --> Hybrid

Hybrid --> Qdrant

Hybrid --> Firestore

Hybrid --> GCS

Hybrid --> Reranker

Reranker --> Citation

@enduml