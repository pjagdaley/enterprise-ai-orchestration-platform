@startuml

'==============================================================================
' Enterprise AI Orchestration Platform
' C4 Model - Level 1 - System Context
'==============================================================================

!theme plain

title Enterprise AI Orchestration Platform
title C4 Model - Level 1 - System Context

left to right direction

skinparam backgroundColor white
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle

skinparam defaultFontName Segoe UI
skinparam defaultFontSize 14

skinparam RectangleBorderColor #404040
skinparam RectangleBorderThickness 1.5
skinparam RectangleRoundCorner 10

skinparam PackageBorderColor #404040
skinparam PackageBorderThickness 2

skinparam ArrowThickness 1.5
skinparam ArrowColor #404040

'==============================================================================
' USERS
'==============================================================================

package "Users" {

actor "Business User" as BusinessUser

actor "Platform\nAdministrator" as PlatformAdmin

actor "AI\nAdministrator" as AIAdmin

}

'==============================================================================
' SYSTEM UNDER DESIGN
'==============================================================================

package "System Under Design" {

rectangle "Enterprise AI\nOrchestration Platform" as EAOP

}

'==============================================================================
' EXTERNAL SYSTEMS
'==============================================================================

package "External Systems" {

rectangle "Vertex AI\n(LLMs & Embeddings)" as VertexAI

rectangle "Firebase\nAuthentication" as Firebase

rectangle "Google Cloud\nStorage" as GCS

rectangle "Enterprise\nContent Sources" as Content

rectangle "Enterprise\nApplications" as Enterprise

rectangle "External MCP\nServers" as MCP

rectangle "Cloud Monitoring\n& Logging" as Monitoring

}

'==============================================================================
' RELATIONSHIPS
'==============================================================================

BusinessUser --> EAOP : Uses AI Platform

PlatformAdmin --> EAOP : Administers Platform

AIAdmin --> EAOP : Configures AI Services

EAOP --> Firebase : Authenticate Users

EAOP --> VertexAI : LLM & Embedding Models

EAOP --> GCS : Document Storage

Content --> GCS : Document Ingestion

EAOP --> Enterprise : Business APIs

EAOP --> MCP : Tool Invocation

EAOP --> Monitoring : Metrics & Logs

@enduml