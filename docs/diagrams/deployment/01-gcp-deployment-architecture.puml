@startuml

title Enterprise AI Orchestration Platform
title GCP Production Deployment Architecture

!theme plain

left to right direction

skinparam backgroundColor white
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle

skinparam defaultFontName Segoe UI
skinparam defaultFontSize 14

skinparam RectangleBorderColor #404040
skinparam RectangleBorderThickness 1.5
skinparam RectangleRoundCorner 10

skinparam PackageBorderColor #404040
skinparam PackageBorderThickness 2

skinparam ArrowThickness 1.5
skinparam ArrowColor #404040

'=========================================================
' USERS
'=========================================================

actor "Business User" as BusinessUser

'=========================================================
' INTERNET
'=========================================================

cloud "Internet" as Internet

'=========================================================
' GOOGLE CLOUD PLATFORM
'=========================================================

package "Google Cloud Platform" {

    package "Cloud Run" {

        rectangle "React Web Portal" as React

        rectangle "FastAPI Backend" as API

    }

    package "AI Services" {

        rectangle "Vertex AI\nGemini" as Gemini

        rectangle "Embedding Models" as Embeddings

    }

    package "Storage" {

        database "Firestore" as Firestore

        database "Google Cloud Storage" as GCS

    }

    package "Compute Engine VM" {

        database "Qdrant Vector Database" as Qdrant

    }

    package "Security" {

        rectangle "Secret Manager" as SecretManager

        rectangle "Cloud IAM" as CloudIAM

    }

    package "Operations" {

        rectangle "Cloud Logging" as CloudLogging

        rectangle "Cloud Monitoring" as CloudMonitoring

    }

}

'=========================================================
' ENTERPRISE SYSTEMS
'=========================================================

package "Enterprise Systems" {

    rectangle "SharePoint" as SharePoint

    rectangle "Google Drive" as GoogleDrive

    rectangle "GitHub" as GitHub

    rectangle "SAP" as SAP

    rectangle "Salesforce" as Salesforce

    rectangle "REST APIs" as RestAPI

}

'=========================================================
' RELATIONSHIPS
'=========================================================

BusinessUser --> Internet

Internet --> React

React --> API

API --> Gemini

API --> Embeddings

API --> Firestore

API --> GCS

API --> Qdrant

API --> SecretManager

API --> CloudIAM

API --> CloudLogging

API --> CloudMonitoring

SharePoint --> GCS

GoogleDrive --> GCS

GitHub --> GCS

SAP --> API

Salesforce --> API

RestAPI --> API

@enduml