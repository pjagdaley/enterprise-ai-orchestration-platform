@startuml

title Enterprise AI Orchestration Platform
title Security Architecture

!theme plain

left to right direction

skinparam backgroundColor white
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle

skinparam defaultFontName Segoe UI
skinparam defaultFontSize 14

skinparam RectangleBorderColor #404040
skinparam RectangleBorderThickness 1.5
skinparam RectangleRoundCorner 10

skinparam PackageBorderColor #404040
skinparam PackageBorderThickness 2

skinparam ArrowThickness 1.5
skinparam ArrowColor #404040

actor "Business User" as BusinessUser

rectangle "React Web Portal" as React

rectangle "FastAPI Backend" as API

package "Identity & Access Management" {

    rectangle "Firebase Authentication" as FirebaseAuth

    rectangle "Cloud IAM" as CloudIAM

    rectangle "Service Accounts" as ServiceAccounts

}

package "Secrets & Encryption" {

    rectangle "Secret Manager" as SecretManager

    rectangle "Cloud KMS" as CloudKMS

}

package "Protected Resources" {

    database "Firestore" as Firestore

    database "Google Cloud Storage" as GCS

    database "Qdrant" as Qdrant

    rectangle "Vertex AI" as VertexAI

}

package "Audit & Monitoring" {

    rectangle "Cloud Logging" as Logging

    rectangle "Cloud Monitoring" as Monitoring

    rectangle "Cloud Audit Logs" as AuditLogs

}

BusinessUser --> React

React --> FirebaseAuth : Authenticate

FirebaseAuth --> API : JWT Token

API --> CloudIAM : Authorization

CloudIAM --> ServiceAccounts

ServiceAccounts --> VertexAI

ServiceAccounts --> Firestore

ServiceAccounts --> GCS

ServiceAccounts --> Qdrant

API --> SecretManager

SecretManager --> CloudKMS

API --> Logging

API --> Monitoring

API --> AuditLogs

@enduml