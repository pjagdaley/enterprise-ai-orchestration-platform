@startuml

title Enterprise AI Orchestration Platform
title Identity & Access Management (IAM)

!theme plain

left to right direction

skinparam backgroundColor white
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle

skinparam defaultFontName Segoe UI
skinparam defaultFontSize 14

skinparam RectangleBorderColor #404040
skinparam RectangleBorderThickness 1.5
skinparam RectangleRoundCorner 10

skinparam PackageBorderColor #404040
skinparam PackageBorderThickness 2

skinparam ArrowColor #404040
skinparam ArrowThickness 1.5

'=========================================================
' USERS
'=========================================================

package "Platform Users" {

actor "Business User" as BusinessUser

actor "Platform Administrator" as PlatformAdmin

actor "AI Administrator" as AIAdmin

}

'=========================================================
' IDENTITY
'=========================================================

package "Identity Provider" {

rectangle "Firebase Authentication" as Firebase

rectangle "JWT Token Service" as JWT

}

'=========================================================
' ACCESS CONTROL
'=========================================================

package "Authorization Layer" {

rectangle "FastAPI Security Middleware" as Security

rectangle "Role Based Access Control" as RBAC

rectangle "Cloud IAM" as IAM

rectangle "Service Accounts" as SA

}

'=========================================================
' PLATFORM SERVICES
'=========================================================

package "Enterprise AI Platform" {

rectangle "FastAPI Backend" as API

database "Firestore" as Firestore

database "Google Cloud Storage" as GCS

database "Qdrant" as Qdrant

rectangle "Vertex AI" as Vertex

}

'=========================================================
' ROLES
'=========================================================

package "Platform Roles" {

rectangle "Business User Role" as BusinessRole

rectangle "Platform Admin Role" as PlatformRole

rectangle "AI Admin Role" as AIRole

}

'=========================================================
' AUTHENTICATION
'=========================================================

BusinessUser --> Firebase

PlatformAdmin --> Firebase

AIAdmin --> Firebase

Firebase --> JWT

JWT --> Security

Security --> RBAC

RBAC --> IAM

IAM --> SA

'=========================================================
' ROLE ASSIGNMENT
'=========================================================

RBAC --> BusinessRole

RBAC --> PlatformRole

RBAC --> AIRole

'=========================================================
' PLATFORM ACCESS
'=========================================================

BusinessRole --> API

PlatformRole --> API

AIRole --> API

API --> Firestore

API --> GCS

API --> Qdrant

API --> Vertex

SA --> Firestore

SA --> GCS

SA --> Vertex

SA --> Qdrant

@enduml