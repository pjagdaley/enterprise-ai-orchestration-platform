@startuml

title Enterprise AI Orchestration Platform
title Secrets Management Architecture

!theme plain

left to right direction

skinparam backgroundColor white
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle

skinparam defaultFontName Segoe UI
skinparam defaultFontSize 14

skinparam RectangleBorderColor #404040
skinparam RectangleBorderThickness 1.5
skinparam RectangleRoundCorner 10

skinparam PackageBorderColor #404040
skinparam PackageBorderThickness 2

skinparam ArrowColor #404040
skinparam ArrowThickness 1.5

'=========================================================
' ADMINISTRATORS
'=========================================================

package "Platform Administrators" {

actor "Security Administrator" as SecurityAdmin

actor "Platform Administrator" as PlatformAdmin

}

'=========================================================
' SECRET MANAGEMENT
'=========================================================

package "Google Secret Manager" {

rectangle "Gemini API Credentials" as GeminiSecret

rectangle "Firebase Credentials" as FirebaseSecret

rectangle "Database Credentials" as DBSecret

rectangle "JWT Signing Key" as JWTSecret

rectangle "External API Keys" as APISecret

}

'=========================================================
' IDENTITY
'=========================================================

package "Identity" {

rectangle "Cloud IAM" as IAM

rectangle "Service Accounts" as SA

}

'=========================================================
' APPLICATION PLATFORM
'=========================================================

package "Application Runtime" {

rectangle "Cloud Run Services" as CloudRun

rectangle "FastAPI Backend" as API

rectangle "LangGraph Runtime" as LangGraph

}

'=========================================================
' PLATFORM SERVICES
'=========================================================

package "Enterprise Services" {

rectangle "Vertex AI" as Vertex

database "Firestore" as Firestore

database "Google Cloud Storage" as GCS

database "Qdrant" as Qdrant

}

'=========================================================
' OPERATIONS
'=========================================================

package "Operations" {

rectangle "Cloud Logging" as Logging

rectangle "Cloud Monitoring" as Monitoring

}

'=========================================================
' ADMINISTRATION
'=========================================================

SecurityAdmin --> GeminiSecret

SecurityAdmin --> FirebaseSecret

SecurityAdmin --> DBSecret

SecurityAdmin --> JWTSecret

SecurityAdmin --> APISecret

PlatformAdmin --> IAM

IAM --> SA

'=========================================================
' SECRET ACCESS
'=========================================================

SA --> CloudRun

CloudRun --> API

API --> LangGraph

CloudRun --> GeminiSecret

CloudRun --> FirebaseSecret

CloudRun --> DBSecret

CloudRun --> JWTSecret

CloudRun --> APISecret

'=========================================================
' PLATFORM ACCESS
'=========================================================

API --> Vertex

API --> Firestore

API --> GCS

API --> Qdrant

'=========================================================
' AUDIT
'=========================================================

CloudRun --> Logging

API --> Logging

LangGraph --> Logging

Logging --> Monitoring

@enduml