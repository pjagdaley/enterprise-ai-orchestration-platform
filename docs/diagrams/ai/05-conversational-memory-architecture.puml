@startuml

title Enterprise AI Orchestration Platform
title Conversational Memory Architecture

!theme plain

left to right direction

skinparam backgroundColor white
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle

skinparam defaultFontName Segoe UI
skinparam defaultFontSize 14

skinparam RectangleBorderColor #404040
skinparam RectangleBorderThickness 1.5
skinparam RectangleRoundCorner 10

skinparam PackageBorderColor #404040
skinparam PackageBorderThickness 2

skinparam ArrowThickness 1.5
skinparam ArrowColor #404040

actor "Business User" as User

rectangle "React Web Portal" as React

rectangle "FastAPI Backend" as API

package "Conversation Management" {

    rectangle "Session Manager" as SessionManager

    rectangle "Context Builder" as ContextBuilder

    rectangle "Prompt Builder" as PromptBuilder

    rectangle "Conversation Memory Service" as MemoryService

}

package "Knowledge Services" {

    rectangle "Search Service" as Search

}

package "Firestore" {

    database "Chat History" as ChatHistory

    database "Sessions" as Sessions

    database "Conversation Metadata" as Metadata

}

package "AI Runtime" {

    rectangle "LangGraph Runtime" as LangGraph

    rectangle "Gemini LLM" as Gemini

}

User --> React

React --> API

API --> SessionManager

SessionManager --> Sessions

SessionManager --> ChatHistory

ChatHistory --> ContextBuilder

Sessions --> ContextBuilder

ContextBuilder --> PromptBuilder

Search --> PromptBuilder

PromptBuilder --> MemoryService

MemoryService --> LangGraph

LangGraph --> Gemini

Gemini --> API

API --> ChatHistory

API --> Metadata

API --> React

React --> User

@enduml