@startuml

'==============================================================================
' Enterprise AI Orchestration Platform
' RAG Reference Architecture
'==============================================================================

!theme plain

title Enterprise AI Orchestration Platform
title RAG Reference Architecture

left to right direction

skinparam backgroundColor white
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle

skinparam defaultFontName Segoe UI
skinparam defaultFontSize 14

skinparam RectangleBorderColor #404040
skinparam RectangleBorderThickness 1.5
skinparam RectangleRoundCorner 10

skinparam PackageBorderColor #404040
skinparam PackageBorderThickness 2

skinparam ArrowThickness 1.5
skinparam ArrowColor #404040

'==============================================================================
' USER
'==============================================================================

actor "Business User" as User

'==============================================================================
' APPLICATION
'==============================================================================

package "Application Layer" {

rectangle "React Web Portal" as React

rectangle "FastAPI Backend" as API

rectangle "Workflow Service" as Workflow

}

'==============================================================================
' RETRIEVAL LAYER
'==============================================================================

package "Retrieval Layer" {

rectangle "Embedding Service" as Embedding

rectangle "Search Service" as Search

rectangle "Hybrid Retriever" as Hybrid

rectangle "CrossEncoder\nReranker" as Reranker

rectangle "Citation Service" as Citation

}

'==============================================================================
' KNOWLEDGE PLATFORM
'==============================================================================

package "Knowledge Platform" {

database "Qdrant\nVector Database" as Qdrant

database "Firestore\nMetadata Registry" as Firestore

database "Google Cloud Storage\nDocuments" as GCS

}

'==============================================================================
' VERTEX AI
'==============================================================================

package "Vertex AI" {

rectangle "Embedding Models" as Embeddings

rectangle "Gemini LLM" as Gemini

}

'==============================================================================
' REQUEST FLOW
'==============================================================================

User --> React

React --> API

API --> Workflow

Workflow --> Embedding

Embedding --> Embeddings

Workflow --> Search

Search --> Hybrid

Hybrid --> Qdrant

Hybrid --> Firestore

Hybrid --> GCS

Hybrid --> Reranker

Reranker --> Citation

Citation --> Gemini

Gemini --> Workflow

Workflow --> API

API --> React

React --> User

@enduml