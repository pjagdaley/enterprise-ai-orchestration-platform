@startuml

title Enterprise AI Orchestration Platform
title Document Processing Pipeline

!theme plain

left to right direction

skinparam backgroundColor white
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle

skinparam defaultFontName Segoe UI
skinparam defaultFontSize 14

skinparam RectangleBorderColor #404040
skinparam RectangleBorderThickness 1.5
skinparam RectangleRoundCorner 10

skinparam PackageBorderColor #404040
skinparam PackageBorderThickness 2

skinparam ArrowThickness 1.5
skinparam ArrowColor #404040

package "Enterprise Sources" {

rectangle "SharePoint" as SharePoint

rectangle "Google Drive" as GoogleDrive

rectangle "GitHub" as GitHub

rectangle "SAP" as SAP

rectangle "Salesforce" as Salesforce

rectangle "REST APIs" as RestAPI

}

package "Ingestion Pipeline" {

rectangle "Ingestion Service" as Ingestion

rectangle "Document Parser" as Parser

rectangle "Metadata Extractor" as Metadata

rectangle "Chunking Engine" as Chunker

rectangle "Embedding Generator" as Embedder

rectangle "Validation Engine" as Validator

}

package "Vertex AI" {

rectangle "Embedding Models" as Embeddings

}

package "Knowledge Platform" {

database "Google Cloud Storage" as GCS

database "Qdrant Vector Database" as Qdrant

database "Firestore Metadata Store" as Firestore

}

SharePoint --> Ingestion

GoogleDrive --> Ingestion

GitHub --> Ingestion

SAP --> Ingestion

Salesforce --> Ingestion

RestAPI --> Ingestion

Ingestion --> Parser

Parser --> Validator

Validator --> Metadata

Metadata --> Chunker

Chunker --> Embedder

Embedder --> Embeddings

Embedder --> Qdrant

Metadata --> Firestore

Parser --> GCS

@enduml