@startuml

'==============================================================================
' Enterprise AI Orchestration Platform
' Document Processing Pipeline
'==============================================================================

!theme plain

title Enterprise AI Orchestration Platform
title Document Processing Pipeline

left to right direction

skinparam backgroundColor white
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle

skinparam defaultFontName Segoe UI
skinparam defaultFontSize 14

skinparam RectangleBorderColor #404040
skinparam RectangleBorderThickness 1.5
skinparam RectangleRoundCorner 10

skinparam PackageBorderColor #404040
skinparam PackageBorderThickness 2

skinparam ArrowThickness 1.5
skinparam ArrowColor #404040

'==============================================================================
' ENTERPRISE CONTENT SOURCES
'==============================================================================

package "Enterprise Content Sources" {

rectangle "Google Drive" as Drive

rectangle "SharePoint" as SharePoint

rectangle "GitHub" as GitHub

rectangle "Local Uploads" as Uploads

rectangle "Enterprise Applications" as Enterprise

}

'==============================================================================
' DOCUMENT INGESTION
'==============================================================================

package "Document Processing" {

rectangle "Document Service" as Document

rectangle "Ingestion Service" as Ingestion

rectangle "Validation Service" as Validation

rectangle "Parser Service" as Parser

rectangle "Chunking Service" as Chunker

rectangle "Metadata Service" as Metadata

rectangle "Embedding Service" as Embedding

}

'==============================================================================
' VERTEX AI
'==============================================================================

package "Vertex AI" {

rectangle "Embedding Models" as Models

}

'==============================================================================
' KNOWLEDGE PLATFORM
'==============================================================================

package "Knowledge Platform" {

database "Google Cloud Storage\n(Document Repository)" as GCS

database "Firestore\nDocument Registry" as Firestore

database "Qdrant\nVector Database" as Qdrant

}

'==============================================================================
' INGESTION FLOW
'==============================================================================

Drive --> Document

SharePoint --> Document

GitHub --> Document

Uploads --> Document

Enterprise --> Document

Document --> GCS : Store Original

Document --> Ingestion

Ingestion --> Validation

Validation --> Parser

Parser --> Chunker

Chunker --> Metadata

Metadata --> Firestore : Store Metadata

Metadata --> Embedding

Embedding --> Models

Embedding --> Qdrant : Store Embeddings

@enduml