@startuml

'==============================================================================
' Enterprise AI Orchestration Platform
' Agentic AI Reference Architecture
'==============================================================================

!theme plain

title Enterprise AI Orchestration Platform
title Agentic AI Reference Architecture

left to right direction

skinparam backgroundColor white
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle

skinparam defaultFontName Segoe UI
skinparam defaultFontSize 14

skinparam RectangleBorderColor #404040
skinparam RectangleBorderThickness 1.5
skinparam RectangleRoundCorner 10

skinparam PackageBorderColor #404040
skinparam PackageBorderThickness 2

skinparam ArrowThickness 1.5
skinparam ArrowColor #404040

'==============================================================================
' USER
'==============================================================================

actor "Business User" as User

rectangle "FastAPI Backend" as API

'==============================================================================
' AGENT ORCHESTRATION
'==============================================================================

package "Agent Orchestration" {

rectangle "Agent Orchestrator" as Orchestrator

rectangle "Planner Agent" as Planner

rectangle "Supervisor Agent" as Supervisor

rectangle "Task Router" as Router

rectangle "Specialized Agents" as Agents

rectangle "Conversation Memory" as Memory

rectangle "Workflow State" as State

}

'==============================================================================
' KNOWLEDGE SERVICES
'==============================================================================

package "Knowledge Services" {

rectangle "Search Service" as Search

rectangle "Citation Service" as Citation

}

'==============================================================================
' MCP
'==============================================================================

package "MCP Layer" {

rectangle "MCP Client" as MCP

rectangle "Tool Registry" as Registry

}

'==============================================================================
' TOOL ECOSYSTEM
'==============================================================================

package "Enterprise Tool Ecosystem" {

rectangle "External MCP Servers" as MCPServers

rectangle "Enterprise Applications" as EnterpriseApps

}

'==============================================================================
' KNOWLEDGE PLATFORM
'==============================================================================

package "Knowledge Platform" {

database "Qdrant" as Qdrant

database "Firestore" as Firestore

database "Google Cloud Storage" as GCS

}

'==============================================================================
' VERTEX AI
'==============================================================================

package "Vertex AI" {

rectangle "Gemini LLM" as Gemini

rectangle "Embedding Models" as Embeddings

}

'==============================================================================
' FLOW
'==============================================================================

User --> API

API --> Orchestrator

Orchestrator --> Planner

Planner --> Supervisor

Supervisor --> Router

Router --> Agents

Agents --> Memory

Agents --> State

Agents --> Search

Search --> Qdrant

Search --> Firestore

Search --> GCS

Search --> Citation

Citation --> Gemini

Agents --> Embeddings

Agents --> MCP

MCP --> Registry

Registry --> MCPServers

Registry --> EnterpriseApps

Supervisor --> API

@enduml