@startuml

title Enterprise AI Orchestration Platform
title AI Safety & Governance Architecture

!theme plain

left to right direction

skinparam backgroundColor white
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle

skinparam defaultFontName Segoe UI
skinparam defaultFontSize 14

skinparam RectangleBorderColor #404040
skinparam RectangleBorderThickness 1.5
skinparam RectangleRoundCorner 10

skinparam PackageBorderColor #404040
skinparam PackageBorderThickness 2

skinparam ArrowThickness 1.5
skinparam ArrowColor #404040

actor "Business User" as User

rectangle "React Web Portal" as React

rectangle "FastAPI Backend" as API

rectangle "LangGraph Runtime" as LangGraph

package "AI Safety & Governance" {

rectangle "Prompt Validation" as PromptValidation

rectangle "Policy Engine" as Policy

rectangle "PII Detection" as PII

rectangle "Content Safety" as Safety

rectangle "Grounding Verification" as Grounding

rectangle "Response Validation" as ResponseValidation

rectangle "Audit Logger" as Audit

}

package "Knowledge Services" {

rectangle "Citation Service" as Citation

}

package "Vertex AI" {

rectangle "Gemini LLM" as Gemini

rectangle "Safety Filters" as SafetyFilters

}

package "Knowledge Platform" {

database "Qdrant" as Qdrant

database "Firestore" as Firestore

database "Google Cloud Storage" as GCS

}

package "Observability" {

rectangle "Cloud Logging" as Logging

rectangle "Cloud Monitoring" as Monitoring

}

User --> React

React --> API

API --> PromptValidation

PromptValidation --> Policy

Policy --> PII

Policy --> Safety

Policy --> LangGraph

LangGraph --> Qdrant

LangGraph --> Firestore

LangGraph --> GCS

LangGraph --> Citation

Citation --> Gemini

Gemini --> SafetyFilters

SafetyFilters --> Grounding

Grounding --> ResponseValidation

ResponseValidation --> Audit

Audit --> Logging

Logging --> Monitoring

ResponseValidation --> API

API --> React

React --> User

@enduml