@startuml

title Enterprise AI Orchestration Platform
title Hybrid Search Architecture

!theme plain

left to right direction

skinparam backgroundColor white
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle

skinparam defaultFontName Segoe UI
skinparam defaultFontSize 14

skinparam RectangleBorderColor #404040
skinparam RectangleBorderThickness 1.5
skinparam RectangleRoundCorner 10

skinparam PackageBorderColor #404040
skinparam PackageBorderThickness 2

skinparam ArrowThickness 1.5
skinparam ArrowColor #404040

actor "Business User" as User

rectangle "FastAPI Backend" as API

package "AI Orchestration" {

    rectangle "Knowledge Retrieval Agent" as Agent

}

package "Knowledge Retrieval Services" {

    rectangle "Search Service" as Search

    rectangle "Query Embedding Service" as QueryEmbedding

    rectangle "Hybrid Retriever" as Hybrid

    rectangle "Metadata Filter" as MetadataFilter

    rectangle "CrossEncoder\nReranker" as Reranker

    rectangle "Citation Service" as Citation

    rectangle "Context Builder" as ContextBuilder

}

package "Knowledge Platform" {

    database "Qdrant\nVector Database" as Qdrant

    database "Firestore\nMetadata Registry" as Firestore

    database "Google Cloud Storage\nDocuments" as GCS

}

package "Vertex AI" {

    rectangle "Embedding Models" as Embeddings

    rectangle "Gemini LLM" as Gemini

}

User --> API

API --> Agent

Agent --> Search

Search --> QueryEmbedding

QueryEmbedding --> Embeddings

Search --> Hybrid

Hybrid --> Qdrant

Hybrid --> Firestore

Hybrid --> GCS

Hybrid --> MetadataFilter

MetadataFilter --> Reranker

Reranker --> Citation

Citation --> ContextBuilder

ContextBuilder --> Gemini

Gemini --> Agent

Agent --> API

API --> User

@enduml