@startuml

'==============================================================================
' Enterprise AI Orchestration Platform
' Model Context Protocol (MCP) Integration
'==============================================================================

!theme plain

title Enterprise AI Orchestration Platform
title Model Context Protocol (MCP) Integration

left to right direction

skinparam backgroundColor white
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle

skinparam defaultFontName Segoe UI
skinparam defaultFontSize 14

skinparam RectangleBorderColor #404040
skinparam RectangleBorderThickness 1.5
skinparam RectangleRoundCorner 10

skinparam PackageBorderColor #404040
skinparam PackageBorderThickness 2

skinparam ArrowThickness 1.5
skinparam ArrowColor #404040

'==============================================================================
' AGENT
'==============================================================================

rectangle "Specialized Agent" as Agent

'==============================================================================
' MCP LAYER
'==============================================================================

package "MCP Layer" {

    rectangle "MCP Client" as MCPClient

    rectangle "Tool Registry" as ToolRegistry

}

'==============================================================================
' MCP SERVERS
'==============================================================================

package "Registered MCP Servers" {

    rectangle "Knowledge MCP Server" as KnowledgeMCP

    rectangle "SAP MCP Server" as SAPMCP

    rectangle "Salesforce MCP Server" as SalesforceMCP

    rectangle "REST API MCP Server" as RestMCP

    rectangle "Email MCP Server" as EmailMCP

    rectangle "Document MCP Server" as DocumentMCP

}

'==============================================================================
' KNOWLEDGE SERVICES
'==============================================================================

package "Knowledge Services" {

    rectangle "Search Service" as Search

}

'==============================================================================
' ENTERPRISE PLATFORMS
'==============================================================================

package "Enterprise Platforms" {

    database "Qdrant" as Qdrant

    database "Firestore" as Firestore

    database "Google Cloud Storage" as GCS

    rectangle "SAP" as SAP

    rectangle "Salesforce" as Salesforce

    rectangle "REST Services" as RestServices

}

'==============================================================================
' FLOW
'==============================================================================

Agent --> MCPClient : Tool Request

MCPClient --> ToolRegistry : Discover Server

ToolRegistry --> KnowledgeMCP
ToolRegistry --> SAPMCP
ToolRegistry --> SalesforceMCP
ToolRegistry --> RestMCP
ToolRegistry --> EmailMCP
ToolRegistry --> DocumentMCP

KnowledgeMCP --> Search

Search --> Qdrant
Search --> Firestore
Search --> GCS

SAPMCP --> SAP

SalesforceMCP --> Salesforce

RestMCP --> RestServices

KnowledgeMCP --> MCPClient
SAPMCP --> MCPClient
SalesforceMCP --> MCPClient
RestMCP --> MCPClient
EmailMCP --> MCPClient
DocumentMCP --> MCPClient

MCPClient --> Agent : Tool Response

@enduml